# Uploads hardening (CLIENT-003 / SEC-001).
# 1) No script execution anywhere under /uploads (defence in depth: uploads are
#    validated PDFs/images, but never let one run as code).
# 2) No directory listings.
# 3) Product SDS/TDS PDFs (paths containing /documents/) are NOT directly
#    downloadable — they are served only via api/download_document.php after the
#    visitor completes the gate form. Product IMAGES (elsewhere under /uploads)
#    stay publicly viewable.

Options -Indexes

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Relative to this /uploads/ directory: block …/products/<id>/documents/<file>
  RewriteRule ^products/.*/documents/ - [F,L]
</IfModule>
