.agents/
.claude/
.superpowers/
frontend/api/config.php
qa/

# Local-only Claude Browser context pack (never commit)
claude_browser_context_pack/
claude_browser_context_pack.zip

# Dependencies and local artifacts (defense in depth; never deploy these)
node_modules/
screenshots/
*.zip
deploy_package*.zip

ftp.env

# Downloaded copies of the live server's files. These routinely include
# api/config.php, which carries the production database password and the LLM
# API key, so a single `git add -A` would put live credentials into history
# permanently. Never commit.
ftp_backup/
live_sync_review/

# Timestamped local backups of config.php taken before editing it. Same
# reason: they contain whichever API key was in use at the time.
*.bak-advisor-*
frontend/api/config.php.bak*

# Editor config. Stock generated files, nothing the project depends on.
.vscode/

# Staging copies assembled per deploy, then superseded by what actually went
# live. Nothing reads from here; the authoritative copies are frontend/ for
# our files and ftp_backup/ for whatever live had at the time.
build/

# Reference packs and client deliverables. Kept on disk because they are the
# locked design spec and the handover documents, but they are ~32MB of images
# and .docx that would sit in history forever.
design_handoff_yee_lim_final/
docs/client-handover/word/
