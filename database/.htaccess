# This directory holds maintenance scripts and SQL, never anything the site
# serves. The cPanel account is chrooted to the web root, so these files can
# only be placed inside it; this denies web access to the whole directory so
# they stay reachable by cron and shell only.
#
# reset_product_views.php also refuses to run unless PHP_SAPI is "cli", so a
# web request would 404 even if this file were missing. Belt and braces.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
